# Điền giá trị thật vào file .env (KHÔNG commit file .env)
DISCORD_TOKEN=
CLIENT_ID=
# Dùng khi dev: lệnh cập nhật ngay trong 1 server. Bỏ trống để đăng ký lệnh toàn cầu.
GUILD_ID=
# Bật nếu cần đọc nội dung tin nhắn (chống spam trùng lặp, link mời).
# Phải bật "Message Content Intent" trong Developer Portal > Bot.
USE_MESSAGE_CONTENT=true
# Webhook cảnh báo raid mặc định (có thể đặt riêng từng server bằng /security webhook)
RAID_WEBHOOK_URL=
